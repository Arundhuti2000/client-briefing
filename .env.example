# Copy to .env. LLM_CHAIN lists the providers to try, in order. A request moves down the chain
# on 429 (after one retry), 402, 5xx, timeouts or a missing key, and when a provider's answer
# fails the validator twice. "mock" (the template) needs no key or network; LLM_CHAIN=mock is
# the safe default. Unset, the chain is gemini,openrouter,ollama,mock.
LLM_CHAIN=mock

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=

# OpenRouter (https://openrouter.ai): ONE request carries the whole list and OpenRouter falls
# through it itself. List only ":free" models (a free model that falls back to a paid one is
# billed at the paid price), e.g. OPENROUTER_MODELS=vendor/model-a:free,vendor/model-b:free.
# Free models allow 50 requests a day without credits.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# any: also replay any cached answer that passed the validator, even from a model that is
# no longer in the chain (for a free, repeatable demo). Empty: only configured models.
CACHE_REPLAY=
